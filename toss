#!/usr/bin/env bash
# toss-invest-mcp CLI 래퍼. AI 없이 터미널에서 시세 조회·주문을 한다.
#
# 사용 전에 빌드가 되어 있어야 한다: ./gradlew build
#
# 예:
#   ./toss price 005930
#   ./toss order buy 005930 --qty 1 --type limit --price 50000       # 미리보기(기본)
#   ./toss order buy 005930 --qty 1 --type limit --price 50000 --execute  # 실제 전송
#
# 종료 코드: 0=성공, 1=REJECTED, 2=UNKNOWN, 3=사용법 오류, 4=그 밖의 실패.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

JAR="$(find "$DIR/build/libs" -maxdepth 1 -name '*.jar' ! -name '*-plain.jar' 2>/dev/null | sort | head -n1)"

if [[ -z "${JAR:-}" ]]; then
    echo "빌드된 jar 를 찾지 못했습니다. 먼저 './gradlew build' 를 실행하세요." >&2
    exit 4
fi

exec java -jar "$JAR" --spring.profiles.active=cli "$@"
